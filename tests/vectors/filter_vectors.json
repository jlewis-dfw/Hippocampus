{
  "normalize_path": [
    {"in": "a/b.md", "out": "a/b.md"},
    {"in": "a\\b\\c.md", "out": "a/b/c.md"},
    {"in": "./a//b.md", "out": "a/b.md"},
    {"in": "Cafe\u0301/n.md", "out": "Caf\u00e9/n.md"},
    {"in": "", "error": "empty-path"},
    {"in": "/etc/passwd", "error": "absolute-path"},
    {"in": "\\\\server\\share\\a.md", "error": "absolute-path"},
    {"in": "C:\\Users\\a.md", "error": "drive-letter"},
    {"in": "../a.md", "error": "path-traversal"},
    {"in": "a\\..\\b.md", "error": "path-traversal"},
    {"in": "a/CON", "error": "windows-reserved-name"},
    {"in": "nul.txt", "error": "windows-reserved-name"},
    {"in": "a/b.", "error": "windows-reserved-name"},
    {"in": "a\u0000b.md", "error": "control-character"}
  ],
  "normalize_text": [
    {"in": "a\r\nb\rc\n", "out": "a\nb\nc\n"},
    {"in": "\ufeff# T", "out": "# T"}
  ],
  "check_path": [
    {"path": "a.md", "expect": ["indexed", null]},
    {"path": "A.MD", "expect": ["indexed", null]},
    {"path": "pic.png", "expect": ["skipped", "extension"]},
    {"path": "noext", "expect": ["skipped", "extension"]},
    {"path": ".hidden", "expect": ["skipped", "extension"]},
    {"path": ".git/x.md", "expect": ["skipped", "default-exclude"]},
    {"path": "Work/.obsidian/app.md", "expect": ["skipped", "default-exclude"]},
    {"path": ".Trash-1000/a.md", "expect": ["skipped", "default-exclude"]},
    {"path": "~$report.md", "expect": ["skipped", "default-exclude"]},
    {"path": "Thumbs.db", "expect": ["skipped", "default-exclude"]},
    {"path": ".obsidian/n.md", "rules": {"default_excludes": false}, "expect": ["indexed", null]},
    {"path": ".env", "expect": ["rejected", "secret-file-name"]},
    {"path": "keys/id_rsa", "expect": ["rejected", "secret-file-name"]},
    {"path": "..\\..\\x.md", "expect": ["rejected", "invalid-path:path-traversal"]},
    {"path": "C:\\x.md", "expect": ["rejected", "invalid-path:drive-letter"]},
    {"path": "big.md", "size": 200001, "expect": ["rejected", "too-large"]},
    {"path": "ok.md", "size": 200000, "expect": ["indexed", null]},
    {"path": "x/PRIVATE-INFRA/a.md", "rules": {"exclude_parts": ["private-infra"]}, "expect": ["rejected", "excluded-source"]},
    {"path": "a.py", "rules": {"extensions": ["py", ".PY"]}, "expect": ["indexed", null]},
    {"path": "a.bin", "rules": {"extensions": []}, "expect": ["indexed", null]},
    {"path": "Work/a.md", "rules": {"include": ["Work/"], "exclude": ["Work/Clients/"]}, "expect": ["indexed", null]},
    {"path": "Journal/a.md", "rules": {"include": ["Work/"]}, "expect": ["skipped", "not-included"]},
    {"path": "Work/Clients/x.md", "rules": {"include": ["Work/"], "exclude": ["Work/Clients/"]}, "expect": ["skipped", "excluded-by-rule"]},
    {"path": "Work/deep/a.draft.md", "rules": {"exclude": ["*.draft.md"]}, "expect": ["skipped", "excluded-by-rule"]},
    {"path": "Projects/x/y/z.md", "rules": {"include": ["Projects/**/*.md"]}, "expect": ["indexed", null]},
    {"path": "top.md", "rules": {"exclude": ["/top.md"]}, "expect": ["skipped", "excluded-by-rule"]},
    {"path": "sub/top.md", "rules": {"exclude": ["/top.md"]}, "expect": ["indexed", null]},
    {"path": "docs/old/a.md", "rules": {"exclude": ["docs/old"]}, "expect": ["skipped", "excluded-by-rule"]},
    {"path": "x/docs/old/a.md", "rules": {"exclude": ["docs/old"]}, "expect": ["indexed", null]},
    {"path": "Work/a.md", "rules": {"exclude": ["/Work/"]}, "expect": ["skipped", "excluded-by-rule"]},
    {"path": "sub/Work/a.md", "rules": {"exclude": ["/Work/"]}, "expect": ["indexed", null]},
    {"path": "a.md", "rules": {"gitignore": "# c\n*.md\n!keep.md\n"}, "expect": ["skipped", "gitignored"]},
    {"path": "keep.md", "rules": {"gitignore": "# c\n*.md\n!keep.md\n"}, "expect": ["indexed", null]},
    {"path": "build-notes/a.txt", "rules": {"gitignore": "build-notes/\n"}, "expect": ["skipped", "gitignored"]},
    {"path": "Work/a/b.md", "rules": {"roots": ["Work", "."]}, "expect": ["indexed", null]},
    {"path": "README.md", "rules": {"roots": ["Work", "."]}, "expect": ["indexed", null]},
    {"path": "Journal/a.md", "rules": {"roots": ["Work", "."]}, "expect": ["skipped", "not-included"]},
    {"path": "workshop/a.md", "rules": {"roots": ["Work"]}, "expect": ["skipped", "not-included"]},
    {"path": "Caf\u00e9/n.md", "rules": {"roots": ["Cafe\u0301"]}, "expect": ["indexed", null]}
  ],
  "check_content": [
    {"text": "# Hello\nbody", "expect": ["indexed", null]},
    {"text": "x\u0000y", "expect": ["skipped", "binary"]},
    {"text": "  \n", "expect": ["skipped", "empty"]},
    {"text": "t ghp_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "expect": ["rejected", "github-token"]},
    {"text": "key AKIAABCDEFGHIJKLMNOP", "expect": ["rejected", "aws-access-key-id"]},
    {"text": "-----BEGIN RSA PRIVATE KEY-----\nabc", "expect": ["rejected", "pem-private-key"]},
    {"text": "Authorization: Bearer abcdefghijklmnopqrstuvwx", "expect": ["rejected", "bearer-token"]},
    {"text": "password = \"hunter2hunter2\"", "expect": ["rejected", "credential-assignment"]},
    {"text": "Password: 'not-a-secret-but-quoted'", "expect": ["rejected", "credential-assignment"]},
    {"text": "the password is stored elsewhere", "expect": ["indexed", null]},
    {"text": "token = ${TOKEN_FROM_ENV}", "expect": ["indexed", null]},
    {"text": "xoxb-1234567890-abcdefghij", "expect": ["rejected", "slack-token"]},
    {"text": "eyJhbGciOiJIUzI1.eyJzdWIiOiIxMjM0.abcdefghijklmn", "expect": ["rejected", "jwt"]}
  ]
}
